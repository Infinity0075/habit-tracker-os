<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:ns1="http://schemas.android.com/tools">
    <array name="com_google_android_gms_fonts_certs">
        <item>@array/com_google_android_gms_fonts_certs_dev</item>
        <item>@array/com_google_android_gms_fonts_certs_prod</item>
    </array>
    <string-array name="com_google_android_gms_fonts_certs_dev">
        <item></item>
    </string-array>
    <string-array name="com_google_android_gms_fonts_certs_prod">
        <item></item>
    </string-array>
    <array name="preloaded_fonts" translatable="false">
        <item>@font/playfair_display_bold</item>
    </array>
    <color name="accent_amber">#FFB020</color>
    <color name="accent_amber_dark">#D89212</color>
    <color name="accent_amber_glow">#33FFB020</color>
    <color name="bg_card">#14141B</color>
    <color name="bg_input">#1C1C26</color>
    <color name="bg_primary">#09090B</color>
    <color name="black">#FF000000</color>
    <color name="card_highlight">#1E1E29</color>
    <color name="divider">#242430</color>
    <color name="green">#22C55E</color>
    <color name="mood_green">#22C55E</color>
    <color name="mood_purple">#8B5CF6</color>
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="red">#FB7185</color>
    <color name="soft_gold">#F6C453</color>
    <color name="stroke_light">#2D2D3A</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="text_dim">#5B5B70</color>
    <color name="text_primary">#F8F8FA</color>
    <color name="text_secondary">#9A9AAC</color>
    <color name="white">#FFFFFFFF</color>
    <string name="add_habit">Add Habit</string>
    <string name="app_name">DisciplineCore</string>
    <string name="delete_habit">Delete Habit</string>
    <string name="no_habits">No habits yet</string>
    <string name="tap_to_add">Tap + to add your first habit</string>
    <string name="today_discipline">TODAY\'S DISCIPLINE</string>
    <style name="AlertDialogDark" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">

        <item name="android:colorBackground">
            @color/bg_card
        </item>

        <item name="colorPrimary">
            @color/accent_amber
        </item>

        <item name="android:textColorPrimary">
            @color/text_primary
        </item>

        <item name="android:textColorSecondary">
            @color/text_secondary
        </item>

    </style>
    <style name="BottomNavText">

        <item name="android:textSize">11sp</item>

        <item name="android:textStyle">bold</item>

        <item name="android:fontFamily">
            sans-serif-medium
        </item>

    </style>
    <style name="BottomSheetShape">

        <item name="cornerFamily">rounded</item>

        <item name="cornerSizeTopLeft">28dp</item>

        <item name="cornerSizeTopRight">28dp</item>

    </style>
    <style name="ModalBottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">

        <item name="backgroundTint">
            @color/bg_card
        </item>

        <item name="shapeAppearanceOverlay">
            @style/BottomSheetShape
        </item>

    </style>
    <style name="PremiumButtonStyle" parent="Widget.MaterialComponents.Button">

        <item name="android:textAllCaps">false</item>

        <item name="cornerRadius">18dp</item>

        <item name="backgroundTint">
            @color/accent_amber
        </item>

        <item name="android:textColor">
            @color/bg_primary
        </item>

        <item name="android:textStyle">bold</item>

        <item name="android:fontFamily">
            sans-serif-medium
        </item>

    </style>
    <style name="PremiumCardStyle" parent="Widget.MaterialComponents.CardView">

        <item name="cardBackgroundColor">@color/bg_card</item>

        <item name="strokeColor">@color/stroke_light</item>

        <item name="strokeWidth">1dp</item>

        <item name="cardCornerRadius">28dp</item>

        <item name="cardElevation">0dp</item>

        <item name="rippleColor">
            @color/accent_amber_glow
        </item>

    </style>
    <style name="Theme.DisciplineCore" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        
        <item name="colorPrimary">@color/accent_amber</item>
        <item name="colorPrimaryVariant">@color/accent_amber_dark</item>
        <item name="colorSecondary">@color/accent_amber</item>

        
        <item name="colorOnPrimary">@color/bg_primary</item>
        <item name="colorOnSecondary">@color/bg_primary</item>

        
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="android:windowBackground">@color/bg_primary</item>

        
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>

        
        <item name="android:windowLightStatusBar" ns1:targetApi="m">false</item>

        <item name="android:windowLightNavigationBar" ns1:targetApi="o_mr1">false</item>

        
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>

        
        <item name="colorControlHighlight">
            @color/accent_amber_glow
        </item>

        
        <item name="materialCardViewStyle">
            @style/PremiumCardStyle
        </item>

        <item name="materialButtonStyle">
            @style/PremiumButtonStyle
        </item>

    </style>
    <style name="Theme.DisciplineCore.BottomSheetDialog" parent="Theme.MaterialComponents.BottomSheetDialog">

        <item name="bottomSheetStyle">
            @style/ModalBottomSheet
        </item>

    </style>
</resources>