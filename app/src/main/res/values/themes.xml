<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ========================================================= -->
    <!-- MAIN APP THEME -->
    <!-- ========================================================= -->

    <style name="Theme.DisciplineCore"
        parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- PRIMARY -->
        <item name="colorPrimary">@color/accent_amber</item>
        <item name="colorPrimaryVariant">@color/accent_amber_dark</item>
        <item name="colorSecondary">@color/accent_amber</item>

        <!-- ON COLORS -->
        <item name="colorOnPrimary">@color/bg_primary</item>
        <item name="colorOnSecondary">@color/bg_primary</item>

        <!-- BACKGROUND -->
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="android:windowBackground">@color/bg_primary</item>

        <!-- SYSTEM BARS -->
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>

        <!-- STATUS/NAV ICONS -->
        <item name="android:windowLightStatusBar"
            tools:targetApi="m">false</item>

        <item name="android:windowLightNavigationBar"
            tools:targetApi="o_mr1">false</item>

        <!-- GLOBAL FONT -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>

        <!-- RIPPLE -->
        <item name="colorControlHighlight">
            @color/accent_amber_glow
        </item>

        <!-- COMPONENT STYLES -->
        <item name="materialCardViewStyle">
            @style/PremiumCardStyle
        </item>

        <item name="materialButtonStyle">
            @style/PremiumButtonStyle
        </item>

    </style>

    <!-- ========================================================= -->
    <!-- PREMIUM CARD STYLE -->
    <!-- ========================================================= -->

    <style name="PremiumCardStyle"
        parent="Widget.MaterialComponents.CardView">

        <item name="cardBackgroundColor">@color/bg_card</item>

        <item name="strokeColor">@color/stroke_light</item>

        <item name="strokeWidth">1dp</item>

        <item name="cardCornerRadius">28dp</item>

        <item name="cardElevation">0dp</item>

        <item name="rippleColor">
            @color/accent_amber_glow
        </item>

    </style>

    <!-- ========================================================= -->
    <!-- PREMIUM BUTTON STYLE -->
    <!-- ========================================================= -->

    <style name="PremiumButtonStyle"
        parent="Widget.MaterialComponents.Button">

        <item name="android:textAllCaps">false</item>

        <item name="cornerRadius">18dp</item>

        <item name="backgroundTint">
            @color/accent_amber
        </item>

        <item name="android:textColor">
            @color/bg_primary
        </item>

        <item name="android:textStyle">bold</item>

        <item name="android:fontFamily">
            sans-serif-medium
        </item>

    </style>

    <!-- ========================================================= -->
    <!-- ALERT DIALOG -->
    <!-- ========================================================= -->

    <style name="AlertDialogDark"
        parent="Theme.MaterialComponents.DayNight.Dialog.Alert">

        <item name="android:colorBackground">
            @color/bg_card
        </item>

        <item name="colorPrimary">
            @color/accent_amber
        </item>

        <item name="android:textColorPrimary">
            @color/text_primary
        </item>

        <item name="android:textColorSecondary">
            @color/text_secondary
        </item>

    </style>

    <!-- ========================================================= -->
    <!-- BOTTOM SHEET -->
    <!-- ========================================================= -->

    <style name="Theme.DisciplineCore.BottomSheetDialog"
        parent="Theme.MaterialComponents.BottomSheetDialog">

        <item name="bottomSheetStyle">
            @style/ModalBottomSheet
        </item>

    </style>

    <style name="ModalBottomSheet"
        parent="Widget.MaterialComponents.BottomSheet.Modal">

        <item name="backgroundTint">
            @color/bg_card
        </item>

        <item name="shapeAppearanceOverlay">
            @style/BottomSheetShape
        </item>

    </style>

    <!-- ========================================================= -->
    <!-- BOTTOM SHEET SHAPE -->
    <!-- ========================================================= -->

    <style name="BottomSheetShape">

        <item name="cornerFamily">rounded</item>

        <item name="cornerSizeTopLeft">28dp</item>

        <item name="cornerSizeTopRight">28dp</item>

    </style>

    <!-- ========================================================= -->
    <!-- BOTTOM NAV TEXT -->
    <!-- ========================================================= -->

    <style name="BottomNavText">

        <item name="android:textSize">11sp</item>

        <item name="android:textStyle">bold</item>

        <item name="android:fontFamily">
            sans-serif-medium
        </item>

    </style>

</resources>